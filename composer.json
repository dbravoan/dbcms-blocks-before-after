{
    "name": "dbravoan/dbcms-blocks-before-after",
    "type": "dbcms-block-package",
    "description": "BeforeAfter",
    "license": "MIT",
    "require": {
        "dbravoan/dbcms-core": "~0.0.1"
    },
    "autoload": {
        "psr-4": {
            "DbCms\\Blocks\\BeforeAfter\\": "./"
        },
        "exclude-from-classmap": [
            "/tests/",
            "/tooling/",
            "/vendor/",
            "/node_modules/"
        ]
    },
    "extra": {
        "dbcms": {
            "identifier": "before_after",
            "name": "BeforeAfter",
            "blocks": [
                "DbCms\\Blocks\\BeforeAfter\\Blocks\\BeforeAfterBlock"
            ],
            "repository": "https://github.com/dbravoan/dbcms-blocks-before-after"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "fixture:lock": "@php tooling/package.php fixture:lock",
        "prepare": "@php tooling/package.php prepare",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/tests.php",
            "@php tooling/package.php test"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php check"
        ],
        "test:dist": [
            "Composer\\Config::disableProcessTimeout",
            "@php tooling/package.php test:dist"
        ],
        "test:tooling": "@php tooling/tests.php",
        "profiles": "@php tooling/package.php profiles"
    },
    "archive": {
        "exclude": [
            "/.build",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/tests",
            "/tooling",
            "/docker",
            "/docs",
            "/AGENTS.md",
            "/compose.yaml",
            "/pint.json",
            "/phpunit.xml",
            "/.node-version",
            "/.dockerignore",
            "/.env",
            "/.env.*",
            "/node_modules",
            "/vendor"
        ]
    }
}
